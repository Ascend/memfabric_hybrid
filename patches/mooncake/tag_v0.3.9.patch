+    static void InitHbmConfig()
+    {
+        auto hbmSizeStr = std::getenv("MF_HBM_SIZE");
+        if (hbmSizeStr) {
+            uint64_t val = atol(hbmSizeStr);
+            if (val <= TB_MEM_BYTES) {
+                config_.hbmSize = (val + GB_MEM_BYTES - 1) & ~(GB_MEM_BYTES - 1);
+            } else {
+                LOG(FATAL) << "Get config hbmSize failed size must in 1GB ~ 1TB"
+                           << " and must align 1GB " << " now is:" << hbmSizeStr;
+            }
+        }
+
+        auto maxHbmSizeStr = std::getenv("MF_MAX_HBM_SIZE");
+        if (maxHbmSizeStr) {
+            uint64_t val = atol(maxHbmSizeStr);
+            if (val >= GB_MEM_BYTES && val <= TB_MEM_BYTES && val >= config_.dramSize) {
+                config_.maxHbmSize = (val + GB_MEM_BYTES - 1) & ~(GB_MEM_BYTES - 1);
+            } else {
+                LOG(FATAL) << "Get config maxDramSize failed size must in 1GB ~ 1TB"
+                           << " and must >= hbmSize:" << config_.hbmSize << " now is:" << maxHbmSizeStr;
+            }
+        } else {
+            config_.maxHbmSize = config_.hbmSize;
+        }
+    }
+
+    static void InitMustConfig()
+    {
+        InitHbmConfig();
+        auto dramSizeStr = std::getenv("MF_DRAM_SIZE");
+        if (dramSizeStr) {
+            uint64_t val = atol(dramSizeStr);
+            if (val <= TB_MEM_BYTES) {
+                config_.dramSize = (val + GB_MEM_BYTES - 1) & ~(GB_MEM_BYTES - 1);
+            } else {
+                LOG(FATAL) << "Get config dramSize failed size must in 1GB ~ 1TB"
+                           << " and must align 1GB " << " now is:" << dramSizeStr;
+            }
+        }
+
+        auto maxDramSizeStr = std::getenv("MF_MAX_DRAM_SIZE");
+        if (maxDramSizeStr) {
+            uint64_t val = atol(maxDramSizeStr);
+            if (val >= GB_MEM_BYTES && val <= TB_MEM_BYTES && val >= config_.dramSize) {
+                config_.maxDramSize = (val + GB_MEM_BYTES - 1) & ~(GB_MEM_BYTES - 1);
+            } else {
+                LOG(FATAL) << "Get config maxDramSize failed size must in 1GB ~ 1TB"
+                           << " and must >= dramSize:" << config_.dramSize << " now is:" << dramSizeStr;
+            }
+        } else {
+            config_.maxDramSize = config_.dramSize;
+        }
+
+        auto worldSizeStr = std::getenv("MF_WORLD_SIZE");
+        if (worldSizeStr) {
+            uint32_t val = static_cast<uint32_t>(atol(worldSizeStr));
+            config_.worldSize = std::min(val, config_.worldSize);
+        }
+
+        auto opTypeStr = std::getenv("MF_OP_TYPE");
+        if (!opTypeStr) {
+            config_.opType = SMEMB_DATA_OP_DEVICE_RDMA;
+        } else if (std::string_view(opTypeStr) == "device_rdma") {
+            config_.opType = SMEMB_DATA_OP_DEVICE_RDMA;
+        } else if (std::string_view(opTypeStr) == "device_sdma") {
+            config_.opType = SMEMB_DATA_OP_SDMA;
+        } else {
+            config_.opType = SMEMB_DATA_OP_BUTT;
+            LOG(WARNING) << "Ignore value from environment variable MF_OP_TYPE";
+        }
+
+        auto storeUrlStr = std::getenv("MF_STORE_URL");
+        if (storeUrlStr) {
+            config_.storeUrl = std::string_view(storeUrlStr);
+        }
+    }
+
+    static void InitOptionalConfig()
+    {
+        auto logLevelStr = std::getenv("MF_LOG_LEVEL");
+        if (logLevelStr) {
+            auto val = atoi(logLevelStr);
+            if (val >= DEBUG_LOG_LEVEL && val <= FATAL_LOG_LEVEL) {
+                config_.logLevel = val;
+            }
+        }
+
+        auto transOpTypeStr = std::getenv("MF_PD_OP_TYPE");
+        if (!transOpTypeStr) {
+            config_.transOpType = SMEMB_DATA_OP_DEVICE_RDMA;
+        } else if (std::string_view(transOpTypeStr) == "device_rdma") {
+            config_.transOpType = SMEMB_DATA_OP_DEVICE_RDMA;
+        } else if (std::string_view(transOpTypeStr) == "device_sdma") {
+            config_.transOpType = SMEMB_DATA_OP_SDMA;
+        } else {
+            config_.transOpType = SMEMB_DATA_OP_BUTT;
+            LOG(WARNING) << "Ignore value from environment variable MF_OP_TYPE:" << transOpTypeStr;
+        }
+
+        auto roleStr = std::getenv("MF_SMEM_TRANS_ROLE");
+        if (roleStr) {
+            if (strcmp(roleStr, "Prefill") == 0) {
+                config_.role = SMEM_TRANS_SENDER;
+            } else if (strcmp(roleStr, "Decode") == 0) {
+                config_.role = SMEM_TRANS_RECEIVER;
+            } else {
+                config_.role = SMEM_TRANS_BUTT;
+                LOG(WARNING) << "Ignore value from environment variable MF_SMEM_TRANS_ROLE";
+            }
+        }
+
+        auto tagStr = std::getenv("MF_RANK_TAG");
+        if (tagStr) {
+            config_.tag = std::string_view(tagStr);
+        }
+
+        auto tagOpInfoStr = std::getenv("MF_RANK_TAG_OP_INFO");
+        if (tagOpInfoStr) {
+            config_.tagOpInfo = std::string_view(tagOpInfoStr);
+        }
+
+        auto enable56BitsGvaStr = std::getenv("MF_ENABLE_56_BITS_GVA");
+        if (enable56BitsGvaStr) {
+             if (strcmp(enable56BitsGvaStr, "TRUE") == 0) {
+                config_.enable56BitsGva = true;
+            }
+        }
+        auto hcomPortStr = std::getenv("MF_HCOM_PORT");
+        if (hcomPortStr) {
+            auto val = atoi(hcomPortStr);
+            if (val > static_cast<int32_t>(STORE_URL_PORT_END) || val < static_cast<int32_t>(STORE_URL_PORT_START)) {
+                LOG(FATAL) << "Get config hcomPort failed port must in 1024 ~ 65534"
+                           << " now is:" << hcomPortStr;
+            } else {
+                config_.hcomPort = static_cast<uint32_t>(val);
+            }
+        }
+    }
+
+    static void InitMemFabricConfig()
+    {
+        InitMustConfig();
+        InitOptionalConfig();
+
+        LOG(INFO) << "Success to load MemFabric config: { worldSize:" << config_.worldSize
+                  << " dramSize:" << config_.dramSize << " maxDramSize:" << config_.maxDramSize
+                  << " hbmSize:" << config_.hbmSize << " maxHbmSize:" << config_.maxHbmSize
+                  << " logLevel:" << config_.logLevel
+                  << " opType:" << config_.opType << " transOpType:" << config_.transOpType
+                  << " storeUrl:" << config_.storeUrl << " transRole:" << config_.role
+                  << " tag:" << config_.tag << " tagOpInfo:" << config_.tagOpInfo << "}";
+    }
+
+    static int32_t LoadMemFabricBmAPI()
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (gLoaded_) {
+            return 0;
+        }
+        InitMemFabricConfig();
+
+        auto smemHandle = dlopen("libmf_smem.so", RTLD_NOW | RTLD_GLOBAL);
+        if (smemHandle == nullptr) {
+            LOG(ERROR) << "Failed to dlopen " << "libmf_smem.so" << " err: " << dlerror();
+            return -1;
+        }
+
+        DLSYM(pSmemBmConfigInit, FUNC_SMEM_BM_CONFIG_INIT, smemHandle, "smem_bm_config_init");
+        DLSYM(pSmemBmInit, FUNC_SMEM_BM_INIT, smemHandle, "smem_bm_init");
+        DLSYM(pSmemBmUninit, FUNC_SMEM_BM_UNINIT, smemHandle, "smem_bm_uninit");
+        DLSYM(pSmemGetRankId, FUNC_SMEM_BM_GET_RANK_ID, smemHandle, "smem_bm_get_rank_id");
+        DLSYM(pSmemBmCreate, FUNC_SMEM_BM_CREATE, smemHandle, "smem_bm_create");
+        DLSYM(pSmemBmCreate2, FUNC_SMEM_BM_CREATE2, smemHandle, "smem_bm_create2");
+        DLSYM(pSmemBmDestory, FUNC_SMEM_BM_DESTROY, smemHandle, "smem_bm_destroy");
+        DLSYM(pSmemBmJoin, FUNC_SMEM_BM_JOIN, smemHandle, "smem_bm_join");
+        DLSYM(pSmemBmLeave, FUNC_SMEM_BM_LEAVE, smemHandle, "smem_bm_leave");
+        DLSYM(pSmemBmGetLocalMemSizeByMemType, FUNC_SMEM_BM_GET_LOCAL_MEM_SIZE_BY_MEM_TYPE, smemHandle,
+              "smem_bm_get_local_mem_size_by_mem_type");
+        DLSYM(pSmemBmPtrByMemType, FUNC_SMEM_BM_PTR_BY_MEM_TYPE, smemHandle, "smem_bm_ptr_by_mem_type");
+        DLSYM(pSmemBmCopy, FUNC_SMEM_BM_COPY, smemHandle, "smem_bm_copy");
+        DLSYM(pSmemBmCopyBatch, FUNC_SMEM_BM_COPY_BATCH, smemHandle, "smem_bm_copy_batch");
+        DLSYM(pSmemBmWait, FUNC_SMEM_BM_WAIT, smemHandle, "smem_bm_wait");
+        DLSYM(pSmemBmRegisterUserMem, FUNC_SMEM_BM_REGISTER_USER_MEM, smemHandle, "smem_bm_register_user_mem");
+        DLSYM(pSmemSetExternLogger, FUNC_SMEM_SET_EXTERN_LOGGER, smemHandle, "smem_set_extern_logger");
+        DLSYM(pSmemSetLogLevel, FUNC_SMEM_SET_LOG_LEVEL, smemHandle, "smem_set_log_level");
+        DLSYM(pSmemCreateConfigStore, FUNC_SMEM_CREATE_CONFIG_STORE, smemHandle, "smem_create_config_store");
+        DLSYM(pSmemTransInit, FUNC_SMEM_TRANS_INIT, smemHandle, "smem_trans_init");
+        DLSYM(pSmemTransUnInit, FUNC_SMEM_TRANS_UNINIT, smemHandle, "smem_trans_uninit");
+        DLSYM(pSmemTransCreate, FUNC_SMEM_TRANS_CREATE, smemHandle, "smem_trans_create");
+        DLSYM(pSmemTransDestory, FUNC_SMEM_TRANS_DESTORY, smemHandle, "smem_trans_destroy");
+        DLSYM(pSmemTransRegisterMem, FUNC_SMEM_TRANS_REGISTER_MEM, smemHandle, "smem_trans_register_mem");
+        DLSYM(pSmemTransUnregisterMem, FUNC_SMEM_TRANS_UNREGISTER_MEM, smemHandle, "smem_trans_deregister_mem");
+        DLSYM(pSmemTransBatchRegisterMem, FUNC_SMEM_TRANS_BATCH_REGISTER_MEM, smemHandle,
+              "smem_trans_batch_register_mem");
+        DLSYM(pSmemTransWrite, FUNC_SMEM_TRANS_WRITE, smemHandle, "smem_trans_write");
+        DLSYM(pSmemTransBatchWrite, FUNC_SMEM_TRANS_BATCH_WRITE, smemHandle, "smem_trans_batch_write");
+        DLSYM(pSmemTransBatchRead, FUNC_SMEM_TRANS_BATCH_READ, smemHandle, "smem_trans_batch_read");
+
+        gLoaded_ = true;
+        LOG(INFO) << "load memfabric api success";
+        return 0;
+    }
+
