+constexpr const char *kTcpPrefix = "tcp://";
+constexpr const char *kEtcdPrefix = "etcd://";
+constexpr size_t kTcpPrefixLen = 6;
+constexpr size_t kEtcdPrefixLen = 7;
+constexpr uint32_t kMaxPort = 65535U;
+
+static void MfRegisterLogger(int level, const char* msg)
+{
+    switch (level) {
+        case DEBUG_LOG_LEVEL:
+            LOG(INFO) << msg;
+            break;
+        case INFO_LOG_LEVEL:
+            LOG(INFO) << msg;
+            break;
+        case WARN_LOG_LEVEL:
+            LOG(WARNING) << msg;
+            break;
+        case ERROR_LOG_LEVEL:
+            LOG(ERROR) << msg;
+            break;
+        default:
+            LOG(INFO) << msg;
+            break;
+    };
+}
+
+int InitMemFabricLog()
+{
+    if (MemFabricSmemDl::SmemSetLogLevel(MemFabricSmemDl::GetMemFabricConfig().logLevel) != 0) {
+        LOG(ERROR) << "mf bm set logger level failed";
+        return -1;
+    }
+
+    if (MemFabricSmemDl::SmemSetExternLogger(MfRegisterLogger) != 0) {
+        LOG(ERROR) << "mf bm set logger func failed";
+        return -1;
+    }
+    return 0;
+}
+
+bool ExtractIpAndPort(const std::string &endpoint, std::string &ip, uint16_t &port,
+                      std::string &protocol) noexcept
+{
+    if (endpoint.empty()) {
+        LOG(ERROR) << "endpoint is empty.";
+        return false;
+    }
+
+    std::string processed;
+    if (endpoint.compare(0, kTcpPrefixLen, kTcpPrefix) == 0) {
+        processed = endpoint.substr(kTcpPrefixLen);
+        protocol = kTcpPrefix;
+    } else if (endpoint.compare(0, kEtcdPrefixLen, kEtcdPrefix) == 0) {
+        processed = endpoint.substr(kEtcdPrefixLen);
+        protocol = kEtcdPrefix;
+    } else {
+        LOG(ERROR) << "protocol not supported, endpoint=" << endpoint;
+        return false;
+    }
+
+    if (processed.empty()) {
+        LOG(ERROR) << "empty host:port part, endpoint=" << endpoint;
+        return false;
+    }
+
+    std::string ipStr;
+    std::string portStr;
+
+    const size_t colonPos = processed.rfind(':');
+    if (colonPos == std::string::npos || colonPos == 0 || colonPos == processed.size() - 1) {
+        LOG(ERROR) << "invalid host:port format, processed=" << processed;
+        return false;
+    }
+
+    ipStr = processed.substr(0, colonPos);
+    portStr = processed.substr(colonPos + 1);
+
+    uint32_t portValue = 0;
+    const char *portBegin = portStr.data();
+    const char *portEnd = portBegin + portStr.size();
+    const auto portRet = std::from_chars(portBegin, portEnd, portValue);
+    if (portRet.ec != std::errc() || portRet.ptr != portEnd) {
+        LOG(ERROR) << "invalid port, portStr=" << portStr << ", endpoint=" << endpoint;
+        return false;
+    }
+
+    if (portValue == 0U || portValue > kMaxPort) {
+        LOG(ERROR) << "port out of range, port=" << portValue << ", endpoint=" << endpoint;
+        return false;
+    }
+
+    port = static_cast<uint16_t>(portValue);
+    ip = ipStr;
+    return true;
+}
+
+int InitMemFabricBm(int deviceId)
+{
+    std::string storeUrl;
+    std::string connUrl;
+    smem_bm_config_t config = {};
+    if (MemFabricSmemDl::SmemBmConfigInit(&config) != 0) {
+        LOG(ERROR) << "Failed to init smem bm config";
+        return -1;
+    }
+    std::string ipStr;
+    uint16_t port;
+    std::string protocol;
+    std::string storeUrlStr = MemFabricSmemDl::GetMemFabricConfig().storeUrl;
+    if (!ExtractIpAndPort(storeUrlStr, ipStr, port, protocol)) {
+        LOG(ERROR) << "Unexpected master server addr: " << storeUrlStr;
+        return -1;
+    }
+    bool etcdMode = storeUrlStr.compare(0, kEtcdPrefixLen, kEtcdPrefix) == 0;
+    port = etcdMode ? port : port + 1;
+    storeUrl = protocol + ipStr + ":" + std::to_string(port);
+    connUrl = "tcp://" + ipStr + ":" + std::to_string(MemFabricSmemDl::GetMemFabricConfig().hcomPort);
+    config.flags |= SMEM_BM_INIT_GVM_FLAG;
+    config.startConfigStoreServer = !etcdMode;
+
+    LOG(INFO) << "start init bm storeUrl=" << storeUrl << ", connUrl=" << connUrl <<
+        ", worldSize=" << MemFabricSmemDl::GetMemFabricConfig().worldSize <<
+        ", deviceId=" << deviceId;
+    std::copy_n(connUrl.c_str(), std::min(sizeof(config.hcomUrl) - 1, connUrl.size()), config.hcomUrl);
+    if (MemFabricSmemDl::SmemBmInit(storeUrl.c_str(), MemFabricSmemDl::GetMemFabricConfig().worldSize,
+                                    deviceId, &config) != 0) {
+        LOG(ERROR) << "Failed to init smem bm:" << storeUrl;
+        return -1;
+    }
+    return 0;
+}
+
+int MemFabricInitSmemBm(int deviceId)
+{
+    if (MemFabricSmemDl::LoadMemFabricBmAPI() != 0) {
+        LOG(ERROR) << "Error: Failed to load MemFabric api";
+        return -1;
+    }
+    smem_bm_t handle = MemFabricSmemDl::GetSmemBmHandle();
+    if (handle != nullptr) {
+        LOG(INFO) << "mf bm already init";
+        return 0;
+    }
+    // log
+    auto ret = InitMemFabricLog();
+    if (ret != 0) {
+        return ret;
+    }
+    // init
+    ret = InitMemFabricBm(deviceId);
+    if (ret != 0) {
+        return ret;
+    }
+    // create
+    smem_bm_create_option_t option{};
+    option.maxDramSize = MemFabricSmemDl::GetMemFabricConfig().maxDramSize;
+    option.maxHbmSize = MemFabricSmemDl::GetMemFabricConfig().maxHbmSize;
+    option.localDRAMSize = MemFabricSmemDl::GetMemFabricConfig().dramSize;
+    option.localHBMSize = MemFabricSmemDl::GetMemFabricConfig().hbmSize;
+    option.dataOpType = MemFabricSmemDl::GetMemFabricConfig().opType;
+    std::copy_n(MemFabricSmemDl::GetMemFabricConfig().tag.c_str(),
+                std::min(sizeof(option.tag) - 1, MemFabricSmemDl::GetMemFabricConfig().tag.size()), option.tag);
+    std::copy_n(MemFabricSmemDl::GetMemFabricConfig().tagOpInfo.c_str(),
+                std::min(sizeof(option.tagOpInfo) - 1, MemFabricSmemDl::GetMemFabricConfig().tagOpInfo.size()),
+                option.tag);
+    option.flags = 0;
+    option.enable56BitsGva = MemFabricSmemDl::GetMemFabricConfig().enable56BitsGva;
+    handle = MemFabricSmemDl::SmemBmCreate2(0, &option);
+    if (handle == nullptr) {
+        MemFabricSmemDl::SmemBmUninit(0);
+        LOG(ERROR) << "Failed to create smem bm";
+        return -1;
+    }
+    // join
+    if (MemFabricSmemDl::SmemBmJoin(handle, 0) != 0) {
+        MemFabricSmemDl::SmemBmDestory(handle);
+        MemFabricSmemDl::SmemBmUninit(0);
+        LOG(ERROR) << "Failed to join smem bm";
+        return -1;
+    }
+    return 0;
+}
+
+int InitMemFabricSmemTrans(const std::string &sessionId, int deviceId)
+{
+    std::string storeUrl;
+    std::string storeUrlStr = MemFabricSmemDl::GetMemFabricConfig().storeUrl;
+    std::string ipStr;
+    uint16_t port;
+    std::string protocol;
+    if (!ExtractIpAndPort(storeUrlStr, ipStr, port, protocol)) {
+        LOG(ERROR) << "Unexpected master server addr: " << storeUrlStr;
+        return -1;
+    }
+    bool etcdMode = storeUrlStr.compare(0, kEtcdPrefixLen, kEtcdPrefix) == 0;
+    storeUrl = protocol + ipStr + ":" + std::to_string(port);
+    smem_trans_config_t config{};
+    config.initTimeout = SMEM_DEFAUT_WAIT_TIME;
+    config.deviceId = deviceId;
+    config.flags |= SMEM_BM_INIT_GVM_FLAG;
+    config.role = MemFabricSmemDl::GetMemFabricConfig().role;
+    config.dataOpType = MemFabricSmemDl::GetMemFabricConfig().transOpType;
+    config.startConfigServer = !etcdMode;
+    if (MemFabricSmemDl::SmemTranInit(&config) != 0) {
+        LOG(ERROR) << "Failed to init smem trans:" << storeUrl;
+        return -1;
+    }
+    // create
+    if (MemFabricSmemDl::SmemTransCreate(storeUrl.c_str(), sessionId.c_str(), &config) == nullptr) {
+        LOG(ERROR) << "Failed to init smem trans:" << storeUrl;
+        return -1;
+    }
+    return 0;
+}
+
+int MemFabricInitSmemTrans(const std::string& sessionId, int deviceId)
+{
+    if (MemFabricSmemDl::LoadMemFabricBmAPI() != 0) {
+        LOG(ERROR) << "Error: Failed to load MemFabric api";
+        return -1;
+    }
+    smem_trans_t handle = MemFabricSmemDl::GetSmemTransHandle();
+    if (handle != nullptr) {
+        LOG(INFO) << "mf smem trans already init";
+        return 0;
+    }
+    // log
+    auto ret = InitMemFabricLog();
+    if (ret != 0) {
+        return ret;
+    }
+    // init config store
+    auto roleStr = std::getenv("MF_SMEM_TRANS_ROLE");
+    std::string storeUrlStr = MemFabricSmemDl::GetMemFabricConfig().storeUrl;
+    // Create config store if role is not "Decode"
+    bool shouldCreateConfigStore = !roleStr || strcmp(roleStr, "Decode") != 0;
+    if (shouldCreateConfigStore) {
+        mooncake::MemFabricSmemDl::SmemCreateConfigStore(storeUrlStr.c_str());
+    } else {
+        LOG(INFO) << "Skip creating config store for Decode role";
+    }
+    // init and create
+    ret = InitMemFabricSmemTrans(sessionId, deviceId);
+    if (ret != 0) {
+        return ret;
+    }
+    return 0;
+}
+int MemFabricInitConfigStore(const std::string& store_address, uint32_t storePort)
+{
+    mooncake::MemFabricSmemDl::LoadMemFabricBmAPI();
+    if (storePort < STORE_URL_PORT_START || storePort > STORE_URL_PORT_END) {
+        LOG(ERROR) << "StorePort out of range:" << storePort;
+        return -1;
+    }
+    std::string storeUrl = "tcp://" + store_address + ":" + std::to_string(storePort);
+    int32_t ret = mooncake::MemFabricSmemDl::SmemSetLogLevel(1);
+    if (ret != 0) {
+        LOG(ERROR) << "mf set logger level failed:" << ret;
+        return -1;
+    }
+    ret = mooncake::MemFabricSmemDl::SmemSetExternLogger(mooncake::MfRegisterLogger);
+    if (ret != 0) {
+        LOG(ERROR) << "mf set logger func failed:" << ret;
+        return -1;
+    }
+    if (mooncake::MemFabricSmemDl::SmemCreateConfigStore(storeUrl.c_str()) != 0) {
+        LOG(ERROR) << "mf create config store failed url:" << storeUrl;
+        return -1;
+    }
+    return 0;
+}
+
+std::pair<void*, size_t> MemFabricGetSegment()
+{
+    auto bmRankId = MemFabricSmemDl::SmemGetRankId();
+    auto handle = MemFabricSmemDl::GetSmemBmHandle();
+    void* ptr = MemFabricSmemDl::SmemBmPtrByMemType(handle, SMEM_MEM_TYPE_HOST, bmRankId);
+    size_t dramSize = MemFabricSmemDl::SmemBmGetLocalMemSizeByMemType(handle, SMEM_MEM_TYPE_HOST);
+    return {ptr, dramSize};
+}
+
+}  // namespace mooncake
