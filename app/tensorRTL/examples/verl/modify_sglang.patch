+    def init_memory_fabric(self, dp_size, dp_rank):
+        from TensorRTL.tensor_rtl.core.backend_config import MfBmConfig
+        from TensorRTL.tensor_rtl.core.executor import MemoryFabricExecutor
+        from memfabric_hybrid import bm
+        local_world_size = torch.distributed.get_world_size()  # 推理单DP组world size
+        process_world_size = local_world_size * dp_size  # 推理(训练)总进程数
+        self.pool_num = 2
+        bm_config = MfBmConfig(mem_type=bm.BmMemType.DEVICE, data_op_type=bm.BmDataOpType.SDMA,
+                            local_dram_size=0, local_hbm_size=os.environ.get("MF_HBM_SIZE", 1024*1024*512),
+                            rank_world_size=process_world_size * self.pool_num)
+        rank_id = torch.distributed.get_rank() + dp_rank * local_world_size + process_world_size
+        self.mf_rank_id = torch.distributed.get_rank() + dp_rank * local_world_size
+
+        self.executor = MemoryFabricExecutor(
+            bm_config, rank_id=rank_id,
+            executor_type=MemoryFabricExecutor.ExecutorType.READER)
+        self.read_gen = None
+        self.cur_bucket_id = 0
+
+        dist.barrier()
+        return True
+
+    def update_weights_mf(
+        self,
+        layer_list_meta: List[LayerMeta],
+        qkv_info: QkvInfo,
+        expert_info: ExpertInfo,
+        train_tp_size: int,
+        train_pp_size: int,
+        infer_tp_size: int,
+        infer_pp_size: int,
+        infer_dp_size: int,
+        reset_needed: bool,
+        pipeline_overlap: bool
+    ):
+        world_size = torch.distributed.get_world_size()
+        self.available_pool = [i * world_size * infer_dp_size for i in range(self.pool_num)]
+
+        next_resume_func = None
+        self.last_bucket = False
+        if reset_needed or (self.read_gen is None):
+            self.mf_named_tensors = []
+            if self.ptensorset_dict == {}:
+                self.read_gen = self._update_weights_mf_generator(
+                    layer_list_meta,
+                    qkv_info,
+                    expert_info,
+                    train_tp_size,
+                    train_pp_size,
+                    infer_tp_size,
+                    infer_pp_size,
+                    infer_dp_size,
+                    pipeline_overlap,
+                )
+            else:
+                self.read_gen = self._update_weights_mf_generator_replay(
+                    layer_list_meta,
+                    qkv_info,
+                    expert_info,
+                    train_tp_size,
+                    train_pp_size,
+                    infer_tp_size,
+                    infer_pp_size,
+                    infer_dp_size,
+                )
+            self.cur_bucket_id = 0
+
+        try:
+            mf_named_tensors_pack = next(self.read_gen)
+            self.cur_bucket_id += 1
+        except StopIteration as e:
+            self.last_bucket = True
+            mf_named_tensors_pack = e.value
+
+        if len(mf_named_tensors_pack) == 2:
+            mf_named_tensors, next_resume_func = mf_named_tensors_pack
+        else:
+            mf_named_tensors = mf_named_tensors_pack
+        _model_load_weights_direct(self.model, mf_named_tensors)  # 最后一轮更新
+
+        if self.last_bucket:
+            if self.read_gen == self._update_weights_mf_generator:
+                self._clear_ptensor_tensor_memory()
+            self._clear_ptensor_op_memory()
+
+        dist.barrier()  # 保证所有卡读完，才可以返回到训练侧
+
+        return True, "Success", next_resume_func
+
+    def read_buf(self):
+        from TensorRTL.examples.verl.test_comm import create_recv_tasks
+
+        task_list = create_recv_tasks(self.mf_rank_id, self.cur_bucket_id, self.available_pool[self.cur_bucket_id % 2])
+        self.executor.execute(task_list)
+
+    def _clear_ptensor_op_memory(self):
+        for _, ptensorset_list in self.ptensorset_dict.items():
+            for ptensorset in ptensorset_list:
+                for op in ptensorset.get_transfer_list():
+                    op.buffer = None
+
+    def _clear_ptensor_tensor_memory(self):
+        for _, ptensorset_list in self.ptensorset_dict.items():
+            for ptensorset in ptensorset_list:
+                for ptensor in ptensorset.ptensor_list:
+                    ptensor.tensor = None
+
+    def _resume_ptensor_op_memory(self, ptensorset_dict, expert_weight, num_moe_experts=1, infer_tp_size=1, bucket_id=0):
+        params_dict = dict(self.model.named_parameters())
+        for param_name, ptensorset_list in ptensorset_dict.items():
+            for ptensorset in ptensorset_list:
+                ops = ptensorset.get_transfer_list()
+                if 'mlp.experts.w13_weight' in param_name or 'mlp.experts.w2_weight' in param_name:
+                    expert_tensor = params_dict[param_name]
+                    for idx, op in enumerate(ops):
+                        op.buffer = expert_tensor[idx]
+                    expert_weight.setdefault(param_name, expert_tensor)
+                else:
+                    for op in ops:
+                        op.buffer = torch.empty(op.tensor_size, dtype=op.dtype, device=torch.npu.current_device())
+
+    def _update_weights_mf_generator_replay(
+        self,
+        layer_list_meta: List[LayerMeta],
+        qkv_info: QkvInfo,
+        expert_info: ExpertInfo,
+        train_tp_size: int,
+        train_pp_size: int,
+        infer_tp_size: int,
+        infer_pp_size: int,
+        infer_dp_size: int,
+    ):  
+        bucket_op = {}
+        bucket_ptensor_set = {}
+        allocate_memory_ptensor_set = {}
+        for param_name, ptensorset_list in self.ptensorset_dict.items():
+            max_bucket_id = -1
+            min_bucket_id = 999
+            for op in ptensorset_list[0].get_transfer_list():
+                bucket_op.setdefault(op.bucket_id, [])
+                bucket_op[op.bucket_id].append(op)
+                max_bucket_id = max(op.bucket_id, max_bucket_id)
+                min_bucket_id = min(op.bucket_id, min_bucket_id)
+
+            allocate_memory_ptensor_set.setdefault(min_bucket_id, {})
+            allocate_memory_ptensor_set[min_bucket_id].setdefault(param_name, ptensorset_list)
+
+            bucket_ptensor_set.setdefault(max_bucket_id, {})
+            bucket_ptensor_set[max_bucket_id].setdefault(param_name, ptensorset_list)
+        num_bucket = self.max_bucket_id
+        expert_weight = {}
+        resume_step = []
+        for bucket_id in range(num_bucket + 1):
+            resume_step.append(partial(self._resume_ptensor_op_memory, allocate_memory_ptensor_set[bucket_id], expert_weight, self.expert_info.num_moe_experts, infer_tp_size, bucket_id))
+        resume_step[0]()
+        resume_step.pop(0)
+        for bucket_id in range(num_bucket + 1):
+            if bucket_id != num_bucket:
+                next_resume_func = resume_step.pop(0)
+            self.executor.execute(bucket_op[bucket_id])
+
+            named_tensors = self._post_process_mf(bucket_ptensor_set[bucket_id], expert_weight, train_tp_size, infer_tp_size, self.qkv_info)
+            if bucket_id == num_bucket:
+                self.last_bucket = True
+                yield named_tensors
+            else:
+                yield named_tensors, next_resume_func
+        del expert_weight
+        return named_tensors
+
+    def _post_process_mf(self, ptensorset_dict, expert_weight, train_tp_size, infer_tp_size, qkv_info):
+        named_tensors = []
+        tensor_list_dict = {}
+        shard_dim_dict = {}
+        for param_name, ptensorset_list in ptensorset_dict.items():
+            for ptensorset in ptensorset_list:
+                if 'mlp.experts.w13_weight' in param_name or 'mlp.experts.w2_weight' in param_name:
+                    named_tensors.append((param_name, expert_weight[param_name]))
+                    continue
+
+                tensor_list_dict.setdefault(param_name, [])
+                shard_dim_dict.setdefault(param_name, -1)
+
+                tensor_shard_dim = ptensorset.ptensor_list[0].shard_dim
+                shard_dim_dict[param_name] = tensor_shard_dim
+                tensor_list_dict[param_name].append(ptensorset.collect_tensor())
+
+        for param_name, tensor_list in tensor_list_dict.items():
+            if len(tensor_list) > 1:
+                tensor_shard_dim = shard_dim_dict[param_name]
+                for fused_tensor in zip(*tensor_list):
+                    tensor = torch.cat(fused_tensor, tensor_shard_dim)
+            else:
+                tensor = tensor_list[0][0]  # id0 表示fused0， id1表示当前device的ptensor的tensor(非Moe每个device只有一个ptensor)
+
+            if 'self_attn.qkv_proj' in param_name:
+                if not (qkv_info.num_query_groups >= train_tp_size and \
+                    qkv_info.num_query_groups >= infer_tp_size):
+                    raise RuntimeError(f"[TensorRTL] heads should be divided in tp ranks.")
+
+                tensor = qkv_from_megatron_to_sglang(
+                    qkv_proj=tensor,
+                    num_query_groups=qkv_info.num_query_groups,
+                    num_attention_heads=qkv_info.num_attention_heads,
+                    q_head_dim=qkv_info.q_head_dim,
+                    k_head_dim=qkv_info.k_head_dim,
+                    v_head_dim=qkv_info.v_head_dim,
+                )
+            named_tensors.append((param_name, tensor))
+        return named_tensors
+
+    def _update_weights_mf_generator(
+        self,
+        layer_list_meta: Optional[List[LayerMeta]],
+        qkv_info: Optional[QkvInfo],
+        expert_info: Optional[ExpertInfo],
+        train_tp_size: int,
+        train_pp_size: int,
+        infer_tp_size: int,
+        infer_pp_size: int,
