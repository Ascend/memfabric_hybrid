+    async def update_weights_mf_async(
+        self, layer_list_meta, train_config, per_tensor_param, pipeline_overlap, train_param_info
+    ):
+        torch_npu.npu.synchronize()
+        pool_num = 2
+        reset_needed = True
+        bucket_id = 0
+        read_done = [asyncio.Event() for _ in range(pool_num)]
+        for pool_id in range(pool_num):
+            read_done[pool_id].set()
+
+        read_tasks = []
+
+        def launch_read(pool_id, reset_needed):
+            """启动一个读任务，读完后自动释放缓冲区"""
+            nonlocal read_tasks
+
+            async def task(reset_needed):
+                nonlocal read_done
+                other_buf = 1 if pool_id == 0 else 0
+                await read_done[other_buf].wait()
+
+                await sgl_update_weights_mf(
+                    engine=self._engine,
+                    device_mesh_key="infer_tp",
+                    device_mesh=self.device_mesh,
+                    layer_list_meta_input=layer_list_meta,
+                    train_config=train_config,
+                    reset_needed=reset_needed,
+                    pipeline_overlap=pipeline_overlap,
+                    train_param_info=train_param_info
+                )
+                read_done[pool_id].set()
+
+            read_tasks.append(asyncio.create_task(task(reset_needed)))
+
+        def safe_next(gen):
+            try:
+                next(gen)
+                return False   # 表示还有更多数据
+            except StopIteration:
+                return True  # 表示生成器结束
+
+        while True:
+            pool_id = bucket_id % 2
+            await read_done[pool_id].wait()
+            await asyncio.to_thread(dist.barrier)
+            read_done[pool_id].clear()
 
+            is_last = await asyncio.to_thread(safe_next, per_tensor_param)
+            await asyncio.to_thread(dist.barrier)   # 在线程池中执行同步 barrier
+            launch_read(pool_id, reset_needed)   # 1.还原之后第一轮正确，第二轮开始出错
+
