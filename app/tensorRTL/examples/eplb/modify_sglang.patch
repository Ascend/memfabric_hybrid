+    def _eplb_planner_hook(self):
+        def hook(module, input, output):
+            if self.experts_transform_manager.get_state() >= EplbState.PLANNER and self.experts_transform_manager.get_state() < EplbState.FINAL:
+                logger.info(f"RUN _eplb_planner_hook")
+                self.experts_transform_manager.on_forward_pass_end()
+
+        return hook
+
+    def _eplb_update_hook(self):
+        def hook(module, input, output):
+            if self.experts_transform_manager.get_state() >= EplbState.UPDATE and self.experts_transform_manager.get_state() < EplbState.FINAL:
+                logger.info(f"RUN _eplb_update_hook")
+                self.experts_transform_manager.on_forward_pass_end()
+
+        return hook
